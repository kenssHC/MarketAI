# === n8n (host local) ===
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Lima

# === Base de datos (sqlite por defecto) ===
DB_TYPE=sqlite
DB_SQLITE_PATH=/home/node/.n8n/database.sqlite

# === Seguridad (solo ejemplo) ===
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === API de IA ===
OPENAI_API_KEY=REEMPLAZA_CON_TU_CLAVE
OPENAI_MODEL=gpt-4o

# === App web / Approval UI ===
PORT=3000
APPROVAL_API_PORT=3001
PGHOST=localhost
PGPORT=5432
PGUSER=marketai_user
PGPASSWORD=marketai_secure_password
PGDATABASE=marketai_seo
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_TIMEOUT_MS=120000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === WordPress / otro ===
WP_BASE_URL=https://tu-dominio.com
WP_APP_USER=tu_usuario_api
WP_APP_PASSWORD=tu_clave_app
GEMINI_API_KEY=tu_api_key_aqui