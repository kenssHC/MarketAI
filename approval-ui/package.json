{
  "name": "marketai-approval-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server --ext js,mjs,json --exec \"node server/index.js\"",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "preview": "npm run build && npm run preview:server",
    "preview:server": "node server/index.js",
    "lint": "eslint \"client/src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "nodemon": "^3.1.4",
    "vite": "^5.4.2"
  }
}
