# ============================================
# .gitignore - Módulo SEO MarketAI
# ============================================

# n8n storage (datos locales)
n8n/storage/binaryData/
n8n/storage/database.sqlite*
n8n/storage/crash.journal
n8n/storage/*.log
n8n/storage/config
n8n/storage/git/
n8n/storage/ssh/

# Variables de entorno
.env
.env.local
.env.*.local

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-*
.vs/

# Backups
*.bak
*.backup
backup/
backups/

# Datos de prueba (opcional, según prefieras)
# test_data/

# Node modules
node_modules/
npm-debug.log
yarn.lock
approval-ui/dist/
approval-ui/client/dist/

# Build artifacts
dist/
build/
*.tsbuildinfo

# PostgreSQL dumps y backups
*.sql.backup
*.dump
postgres_data/

# Certificados SSL (si usas localmente)
*.pem
*.key
*.crt
*.cert

# Railway
.railway/

# Credenciales sensibles (nunca subir)
*credentials*.json
*secret*.json
*apikey*.txt

# Workflows
n8n/workflows/